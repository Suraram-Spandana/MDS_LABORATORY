        "import pandas as pd\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.metrics import r2_score\n",
        "\n",
        "# -----------------------------------\n",
        "# 1. Load the dataset\n",
        "# -----------------------------------\n",
        "\n",
        "df = pd.read_csv(\"/content/House-Price.csv\")\n",
        "\n",
        "# -----------------------------------\n",
        "# 2. Select numerical columns\n",
        "# -----------------------------------\n",
        "\n",
        "columns = [\n",
        "    \"price\",\n",
        "    \"bedrooms\",\n",
        "    \"bathrooms\",\n",
        "    \"sqft_living\",\n",
        "    \"sqft_lot\",\n",
        "    \"floors\",\n",
        "    \"waterfront\",\n",
        "    \"view\",\n",
        "    \"condition\",\n",
        "    \"sqft_above\",\n",
        "    \"sqft_basement\",\n",
        "    \"yr_built\",\n",
        "    \"yr_renovated\"\n",
        "]\n",
        "\n",
        "df = df[columns]\n",
        "\n",
        "# Remove missing values\n",
        "df = df.dropna()\n",
        "\n",
        "print(\"Original dataset size:\", df.shape)\n",
        "\n",
        "# -----------------------------------\n",
        "# 3. Remove outliers using IQR\n",
        "# -----------------------------------\n",
        "\n",
        "feature_columns = [\n",
        "    \"bedrooms\",\n",
        "    \"bathrooms\",\n",
        "    \"sqft_living\",\n",
        "    \"sqft_lot\",\n",
        "    \"floors\",\n",
        "    \"waterfront\",\n",
        "    \"view\",\n",
        "    \"condition\",\n",
        "    \"sqft_above\",\n",
        "    \"sqft_basement\",\n",
        "    \"yr_built\",\n",
        "    \"yr_renovated\"\n",
        "]\n",
        "\n",
        "Q1 = df[feature_columns].quantile(0.25)\n",
        "Q3 = df[feature_columns].quantile(0.75)\n",
        "\n",
        "IQR = Q3 - Q1\n",
        "\n",
        "lower_limit = Q1 - 1.5 * IQR\n",
        "upper_limit = Q3 + 1.5 * IQR\n",
        "\n",
        "# Remove rows containing outliers\n",
        "df_clean = df[\n",
        "    ~(\n",
        "        (df[feature_columns] < lower_limit) |\n",
        "        (df[feature_columns] > upper_limit)\n",
        "    ).any(axis=1)\n",
        "]\n",
        "\n",
        "print(\"Dataset size after removing outliers:\", df_clean.shape)\n",
        "print(\"Number of rows removed:\", len(df) - len(df_clean))\n",
        "\n",
        "# -----------------------------------\n",
        "# 4. Define X and Y\n",
        "# -----------------------------------\n",
        "\n",
        "X = df_clean[feature_columns]\n",
        "\n",
        "Y = df_clean[\"price\"]\n",
        "\n",
        "# -----------------------------------\n",
        "# 5. Split into training and testing\n",
        "# -----------------------------------\n",
        "\n",
        "X_train, X_test, Y_train, Y_test = train_test_split(\n",
        "    X,\n",
        "    Y,\n",
        "    test_size=0.2,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "# -----------------------------------\n",
        "# 6. Create Linear Regression model\n",
        "# -----------------------------------\n",
        "\n",
        "model = LinearRegression()\n",
        "\n",
        "# Train the model\n",
        "model.fit(X_train, Y_train)\n",
        "\n",
        "# -----------------------------------\n",
        "# 7. Predict house prices\n",
        "# -----------------------------------\n",
        "\n",
        "Y_pred = model.predict(X_test)\n",
        "\n",
        "# -----------------------------------\n",
        "# 8. Calculate R-squared\n",
        "# -----------------------------------\n",
        "\n",
        "r2 = r2_score(Y_test, Y_pred)\n",
        "\n",
        "# -----------------------------------\n",
        "# 9. Display results\n",
        "# -----------------------------------\n",
        "\n",
        "print(\"\\nR-squared value:\", r2)\n",
        "print(\"R-squared percentage:\", r2 * 100, \"%\")"
